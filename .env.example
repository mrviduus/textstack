# .env.example
# Copy to .env and fill in values

# Database
POSTGRES_USER=textstack_prod
POSTGRES_PASSWORD=<secure-password>
POSTGRES_DB=textstack_prod
# The V2 database (ADR-030) in the same Postgres. `docker compose up` does NOT create it:
# migrator-v2 is behind profile `v2`, so creating and migrating it is `make migrate-v2`.
# Backups dump it by this name when it exists (make backup, backup.yml, deploy.yml); undo the
# baseline with `make migrate-v2-drop CONFIRM=<this name>`.
V2_POSTGRES_DB=textstack_v2
# The V2 sync API (/me/v2/*, docs/01-architecture/v2-sync-protocol.md). Off: not mapped, 404. On:
# it reads V2_POSTGRES_DB; a V2 database that is missing or behind answers 503 there, nowhere else.
# Drives the Api (Features__V2Api: /me/v2 + the MCP manifest's V2 tools), the Worker (the same
# Features__V2Api: the transitional V2 extraction loop and the V2 file sweeps) and the mcp-server
# bridge (TEXTSTACK_MCP_V2: registers those tools).
# On, health-check.yml alarms unless V2 is `ok`, and restore-drill.yml fails if a backup has no V2 dump.
FEATURES_V2API=false
# V2 library bytes (library/ books + covers, uploads/ parts) live in ./data/library, mounted at
# /library (Storage__LibraryRoot) on api and worker: outside the public ./data/storage, so nothing
# serves them; only /me/v2 does, owner-checked. Backed up to R2 with storage (backup.yml).

# JWT
JWT_SECRET=<min-32-char-secret>
JWT_ISSUER=textstack.app
JWT_AUDIENCE=textstack.app

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
# Optional: comma-separated extra Google OAuth client IDs accepted during
# rotation (e.g. while old mobile builds are still in the wild).
# GOOGLE_LEGACY_CLIENT_IDS=old-id-1,old-id-2

# Environment
ASPNETCORE_ENVIRONMENT=Production

# IndexNow (Bing/Yandex instant indexing)
INDEXNOW_KEY=
INDEXNOW_ENABLED=false

# OpenAI (contextual /explain endpoint + translation)
OPENAI_API_KEY=
# Models: leave empty to use the defaults in TextStack.Ai.Llm.OpenAiOptions (the only place they live).
# Set only to override. gpt-5-mini / o-series are reasoning models (slow, costly on short hot-path tasks).
OPENAI_MODEL=
# Explain + tutor; also the teacher model for Explain distillation.
OPENAI_EXPLAIN_MODEL=

# Resend (email: password reset + admin ops alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@textstack.app
# Where SEO backfill / ops failure alerts go. Empty = alerts disabled.
ADMIN_ALERT_EMAIL=

# Sentry (error tracking + LLM agent/provider-routing spans).
# One DSN for every backend service — api, worker, mcp-server and ssg-worker (Node) all read
# SENTRY_DSN and report into the same project, told apart by the `service` tag. Each scrubs
# before sending: no request bodies, no query strings, no credentials, no book text.
# WARNING: a local ASPNETCORE_ENVIRONMENT=Production together with a real SENTRY_DSN
# writes DEV events into the PRODUCTION Sentry project tagged environment=Production.
# That has already happened once and was read as a production incident. Keep
# ASPNETCORE_ENVIRONMENT=Development locally. As a backstop the SDK downgrades the tag to
# `production-unverified` when SENTRY_RELEASE is absent (CI images always set it from GIT_SHA).
# Empty or unset ⇒ Sentry is a complete no-op: the SDK is never initialized, no
# middleware is added, nothing leaves the process. That is the intended state for
# local dev, CI and forks. Set it in .env (never commit a DSN).
# SENTRY_DSN=
# Transaction sample rate for http.server (0..1). Agent spans always sample at
# 1.0 and /health never samples — see backend/src/Infrastructure/Telemetry/.
# Sentry__TracesSampleRate=0.2

# OpenTelemetry export (traces, metrics, logs) for api + worker. Empty or unset ⇒ nothing is
# exported or even collected — the production default, because nothing there receives it. Set it
# only when something listens; locally that is Aspire:
#   docker compose --profile observability up -d aspire-dashboard   → UI on 127.0.0.1:18888
# OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889

# Oldest Android build (versionCode — the number in brackets in Profile → About, e.g. 23) allowed
# to run. Below it the app shows a blocking "Please update TextStack" screen. A build number, not
# the version name: every build reports version 1.0.0. Empty or <=0 = no minimum. Never enforced
# server-side.
# MOBILE_MIN_SUPPORTED_BUILD=
# Newest Android versionCode on the tester track. A build below it (and at or above the minimum)
# sees a dismissible "new version available" bar. Bump it after each build is FULLY rolled out on Play (a staged rollout would nudge to an update Play does not offer yet).
# Empty or <=0 = no bar.
# MOBILE_LATEST_BUILD=

# PDF content cleanup (quality-poll.sh Phase 3 — feat-0007).
# When true, chapters scoring below the threshold get an LLM cleanup pass
# via Claude CLI. Off by default — leaves the poller at structure-only.
# CLEANUP_TIMEOUT: per-chapter Claude budget; 20k-word chapters take ~15-20 min.
CONTENT_CLEANUP_ENABLED=false
CONTENT_QUALITY_THRESHOLD=60
CLEANUP_TIMEOUT=1500
