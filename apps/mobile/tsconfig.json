{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "@textstack/shared": [
        "../../packages/shared/src/index"
      ],
      "@textstack/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "exclude": [
    "e2e"
  ]
}
