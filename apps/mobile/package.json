{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "EXPO_PUBLIC_API_URL=http://localhost:8083/api expo start --web",
    "proxy": "node proxy.js",
    "web:dev": "node proxy.js & EXPO_PUBLIC_API_URL=http://localhost:8083/api expo start --web; kill %1",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "update": "eas update",
    "build:pdf": "pnpm -C ../web build:mobile-pdf",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts --project=android",
    "test:e2e:ios": "npx playwright test --config=e2e/playwright.config.ts --project=ios",
    "test:e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --project=android --ui",
    "submit:internal": "eas submit --platform android --profile internal",
    "submit:closed": "eas submit --platform android --profile closed",
    "submit:production": "eas submit --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "check:permissions": "node scripts/check-android-permissions.mjs",
    "build:dyslexic-font": "node scripts/build-dyslexic-font.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@sentry/react-native": "^8.23.0",
    "expo": "~55.0.9",
    "expo-apple-authentication": "~55.0.9",
    "expo-application": "~55.0.19",
    "expo-asset": "^55.0.10",
    "expo-audio": "~55.0.14",
    "expo-build-properties": "~55.0.17",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.19",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "~55.0.20",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.12",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~55.0.14",
    "expo-keep-awake": "~55.0.6",
    "expo-linking": "~55.0.9",
    "expo-notifications": "~55.0.19",
    "expo-router": "~55.0.8",
    "expo-secure-store": "~55.0.9",
    "expo-splash-screen": "~55.0.13",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.20",
    "pdfjs-dist": "4.10.38",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
