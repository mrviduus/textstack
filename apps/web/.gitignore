

# Emitted by `tsc -b` beside vite.config.ts, because tsconfig.node.json compiles
# it. They are build output that looks like source, and they were committed once
# by a `git add -A` in a docs-only change before anyone noticed.
vite.config.js
vite.config.d.ts

# Written by images.yml at build time (tools/checks/changelog-data.mjs), never committed.
public/changelog.json

# The Android shell's build (`pnpm build:android`); apps/android copies it into the APK.
dist-android/
