{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@textstack/shared": ["../../packages/shared/src/index.ts"],
      "@textstack/shared/*": ["../../packages/shared/src/*"],
      "@textstack/reader-overlay": ["../../packages/reader-overlay/src/index.ts"],
      "@textstack/reader-engine": ["../../packages/reader-engine/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/reader-overlay/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
