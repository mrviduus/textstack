# Build-time values of the production web bundle — the ONLY place they are set.
# Read with `set -a; . apps/web/production.env; set +a` by images.yml (the bundle the
# server pulls) and by deploy.yml (its fallback build on the server). Vite inlines
# these into public JS, so everything here is public by design; a secret never
# goes in this file, and the dist scan would fail the build if one did.
#
# Not `.env.production`: vite would then read it in every build (CI, e2e, local),
# and deploy.yml moves `apps/web/.env*` aside on the server.
#
# VITE_GOOGLE_CLIENT_ID must match the API's Google__ClientId. A stale copy of it
# (another project's id) broke Google sign-in for months.
VITE_API_URL=/api
VITE_STORAGE_URL=https://textstack.app
VITE_CANONICAL_URL=https://textstack.app
VITE_GOOGLE_CLIENT_ID=726577729877-0lc197ngqf9qb297tvgh22q2k7g72l4l.apps.googleusercontent.com
