# SSG Worker Container
# Long-running process that polls DB for SSG jobs and executes prerender
#
# Builds from the repository root, not from apps/web. A pnpm workspace has one
# lockfile, and `catalog:` specifiers cannot be resolved without
# pnpm-workspace.yaml in scope — so an image built from apps/web alone can no
# longer install anything. The repo layout is kept inside the image (/repo/...)
# rather than flattened, so the paths in docker-compose and in ssg-worker.mjs
# stay recognisable.

# Keep in step with .nvmrc — a Dockerfile cannot read it, so
# scripts/check-node-version.mjs fails CI when they drift.
ARG NODE_VERSION=24.20.0
FROM node:${NODE_VERSION}-alpine

# Install Chromium and dependencies for Puppeteer
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

WORKDIR /repo

# pnpm version comes from `packageManager` in the root package.json — one
# declaration, the same one CI and developers use. It used to be `pnpm@9` here
# and `pnpm@9.15.0` in the admin image, whose comment already recorded someone
# hitting corepack drift.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN corepack enable && corepack prepare --activate

# Every workspace member's manifest, because --frozen-lockfile validates the
# lockfile against all of them. Manifests only — no sources yet, so the install
# layer survives an edit to any app.
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY apps/mobile/package.json apps/mobile/
COPY packages/shared/package.json packages/shared/
COPY packages/reader-overlay/package.json packages/reader-overlay/

# Store deleted in the same layer — see apps/admin/Dockerfile.
RUN pnpm install --frozen-lockfile --filter textstack-web... \
    && rm -rf "$(pnpm store path)"

COPY apps/web/scripts/ ./apps/web/scripts/
COPY packages/ ./packages/

WORKDIR /repo/apps/web
RUN mkdir -p dist/ssg

ENV NODE_ENV=production
ENV POLL_INTERVAL=5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pgrep -f "ssg-worker.mjs" || exit 1

USER node
CMD ["node", "scripts/ssg-worker.mjs"]
