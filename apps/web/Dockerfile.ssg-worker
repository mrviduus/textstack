# SSG Worker Container
# Long-running process that polls DB for SSG jobs and executes prerender
#
# Builds from the repository root, not from apps/web. A pnpm workspace has one
# lockfile, and `catalog:` specifiers cannot be resolved without
# pnpm-workspace.yaml in scope. The repo layout is kept inside the image
# (/repo/apps/web/...) so the paths in docker-compose and in ssg-worker.mjs stay
# recognisable.
#
# Base images are pinned by digest (tag kept for humans); Dependabot moves them.
# The node tag must match .nvmrc — a Dockerfile cannot read it, so
# scripts/check-node-version.mjs fails CI when they drift.

# ---- deps: production dependencies of textstack-web only ----
#
# The scripts import three packages: pg and @sentry/node (ssg-worker.mjs) and
# puppeteer (prerender.mjs). All are `dependencies` of textstack-web for this reason —
# `pnpm deploy --prod` installs a package's production tree, from the lockfile,
# into a directory of its own. The old `pnpm install --filter textstack-web...`
# did not isolate anything: the workspace is hoisted (for Metro), so it installed
# web's devDependencies (vite, vitest, playwright, jsdom…) and mobile's whole tree.
FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS deps
WORKDIR /repo
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN corepack enable && corepack prepare --activate
# Every member's manifest: --frozen-lockfile validates the lockfile against all of them.
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY apps/mobile/package.json apps/mobile/
COPY packages/shared/package.json packages/shared/
COPY packages/reader-overlay/package.json packages/reader-overlay/
COPY packages/reader-engine/package.json packages/reader-engine/
# Puppeteer drives the distro Chromium below; its own browser download is skipped.
# (PUPPETEER_SKIP_CHROMIUM_DOWNLOAD, which this used to set, is the pre-v20 name and
# Puppeteer 25 ignores it — so the image used to carry Chrome AND chrome-headless-shell
# on top of the apk Chromium it actually launched.)
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN pnpm --filter textstack-web deploy --prod --legacy --frozen-lockfile /deploy

# ---- runtime ----
FROM node:24.20.0-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf

RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_DOWNLOAD=true

WORKDIR /repo/apps/web
COPY --from=deps /deploy/node_modules ./node_modules
COPY apps/web/scripts/ ./scripts/
RUN mkdir -p dist/ssg

ENV NODE_ENV=production
ENV POLL_INTERVAL=5000

# Sentry release, as in the .NET images. Declared late so a new SHA invalidates
# only this trivial layer. Empty = no release, and the environment then reports
# as production-unverified (ssgSentry.mjs).
ARG GIT_SHA=""
ENV SENTRY_RELEASE=$GIT_SHA

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD pgrep -f "ssg-worker.mjs" || exit 1

USER node
CMD ["node", "scripts/ssg-worker.mjs"]
