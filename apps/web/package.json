{
  "name": "textstack-web",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ssg": "tsc && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "build:mobile-engine": "node scripts/build-mobile-engine.mjs",
    "build:mobile-pdf": "node scripts/build-mobile-pdf.mjs",
    "build:v2-reader": "node ../mobile/src/lib/v2reader/build.mjs",
    "check:mobile-engine": "node scripts/check-mobile-engine.mjs",
    "check:mobile-pdf": "node scripts/check-mobile-pdf.mjs",
    "check:v2-reader": "node ../mobile/src/lib/v2reader/build.mjs --check",
    "check:v2-reader-sandbox": "node --experimental-strip-types ../mobile/src/lib/v2reader/sandbox.check.mjs"
  },
  "dependencies": {
    "@sentry/node": "catalog:",
    "@sentry/react": "catalog:",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "pdfjs-dist": "catalog:",
    "pg": "^8.20.0",
    "puppeteer": "^25.16.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "react-router-dom": "catalog:",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "^0.28.0",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
