{
  "name": "textstack-web",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/assert-no-dev-reader.mjs",
    "build:android": "tsc && set -a && . ./production.env && . ./android.env && set +a && VITE_TARGET=android vite build --outDir dist-android && node scripts/assert-no-dev-reader.mjs dist-android",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "build:reader": "node ../../packages/reader/src/build.mjs",
    "check:reader": "node ../../packages/reader/src/build.mjs --check",
    "check:reader-sandbox": "node --experimental-strip-types ../../packages/reader/src/sandbox.check.mjs",
    "check:reader-formats": "node --experimental-strip-types ../../packages/reader/src/formats.check.mjs",
    "check:reader-prod-csp": "node --experimental-strip-types ../../packages/reader/src/prodCsp.check.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "catalog:",
    "@capacitor-community/sqlite": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/filesystem": "catalog:",
    "@capacitor/network": "catalog:",
    "@capgo/capacitor-social-login": "catalog:",
    "@sentry/react": "catalog:",
    "cmdk": "^1.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "^10.1.0",
    "react-router-dom": "catalog:",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "^0.28.0",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
