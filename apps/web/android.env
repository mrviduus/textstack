# Build-time values of the Android shell's bundle (apps/android, ADR-035). Read by `pnpm build:android`.
# The same rules as production.env: Vite inlines these into public JS, so a secret never goes here.
# The shell's page runs at https://localhost, so the API address is absolute.
VITE_API_URL=https://textstack.app/api
VITE_STORAGE_URL=https://textstack.app
VITE_CANONICAL_URL=https://textstack.app
VITE_GOOGLE_CLIENT_ID=726577729877-0lc197ngqf9qb297tvgh22q2k7g72l4l.apps.googleusercontent.com
