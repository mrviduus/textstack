<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\src\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The unit tests' clock and token secret, shared rather than copied. -->
  <ItemGroup>
    <Compile Include="..\TextStack.UnitTests\SteppedClock.cs" Link="Shared\SteppedClock.cs" />
    <Compile Include="..\TextStack.UnitTests\TestTokens.cs" Link="Shared\TestTokens.cs" />
  </ItemGroup>
</Project>
